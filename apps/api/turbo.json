{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["$TURBO_EXTENDS$", "trpc:generate"]
		},
		"trpc:generate": {
			"dependsOn": ["^build"],
			"inputs": ["src/**/*.ts"],
			"outputs": ["src/generated/**"]
		},
		"dev": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"AUTH_COOKIE_DOMAIN",
				"AUTH_TRUSTED_ORIGINS",
				"BLOB_READ_WRITE_TOKEN",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"CACHE_TTL_MS",
				"DATABASE_URL",
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"MICROSOFT_CLIENT_ID",
				"MICROSOFT_CLIENT_SECRET",
				"MICROSOFT_TENANT_ID",
				"PORT",
				"REDIS_URL"
			]
		},
		"test": {
			"passThroughEnv": [
				"AUTH_COOKIE_DOMAIN",
				"AUTH_TRUSTED_ORIGINS",
				"BLOB_READ_WRITE_TOKEN",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"CACHE_TTL_MS",
				"DATABASE_URL",
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"MICROSOFT_CLIENT_ID",
				"MICROSOFT_CLIENT_SECRET",
				"MICROSOFT_TENANT_ID",
				"PORT",
				"REDIS_URL"
			]
		}
	}
}
