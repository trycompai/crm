{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".eve/**", ".output/**", ".vercel/output/**"]
		},
		"check-types": {
			"dependsOn": ["topo", "^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"AGENT_BRIDGE_SECRET",
				"AI_GATEWAY_API_KEY",
				"BLOB_READ_WRITE_TOKEN",
				"DATABASE_URL",
				"GITHUB_TOKEN",
				"HUNTER_API_KEY",
				"BRAVE_SEARCH_API_KEY",
				"PERPLEXITY_API_KEY",
				"RAPIDAPI_KEY"
			]
		},
		"test": {
			"dependsOn": ["topo", "^build"],
			"passThroughEnv": [
				"DATABASE_URL",
				"HUNTER_API_KEY",
				"BRAVE_SEARCH_API_KEY"
			]
		}
	}
}
