# syntax=docker/dockerfile:1.7

FROM oven/bun:1.3.12-slim AS release

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json bun.lock .npmrc turbo.json biome.jsonc ./
COPY apps/agent/package.json apps/agent/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/app/package.json apps/app/package.json
COPY packages/auth/package.json packages/auth/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/env/package.json packages/env/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY apps/api/scripts/chmod-trpc-binary.mjs apps/api/scripts/chmod-trpc-binary.mjs
COPY packages/db/prisma packages/db/prisma

RUN bun install --frozen-lockfile

COPY . .

ARG CRM_PUBLIC_URL=https://crm.letrasverticais.com
ENV API_URL=${CRM_PUBLIC_URL}
ENV APP_URL=${CRM_PUBLIC_URL}
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build

RUN bun run --filter=@crm/db db:generate \
	&& bun run --filter=app build \
	&& bun run --filter=agent build
