{
  "worktree": {
    "bgIsolation": "none"
  },
  "enabledPlugins": {
    "paper-desktop@paper": true,
    "bluecats-sdlc@bluecats": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
