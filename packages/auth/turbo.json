{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"auth:generate": {
			"cache": false,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"check-types": {
			"passThroughEnv": ["DATABASE_URL"]
		},
		"test": {
			"dependsOn": ["topo", "^build"],
			"passThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "TEST_RUN_ID"]
		}
	}
}
