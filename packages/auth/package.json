{
	"name": "@crm/auth",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./cookies": "./src/cookies.ts",
		"./scopes": "./src/scopes.ts",
		"./workspace": "./src/workspace.ts"
	},
	"scripts": {
		"auth:generate": "better-auth generate --config src/auth.ts --output ../db/prisma/schema.prisma --y",
		"check-types": "tsc --noEmit",
		"oauth:reconcile-client": "bun scripts/reconcile-oauth-client.ts",
		"oauth:register-client": "bun scripts/register-oauth-client.ts",
		"lint": "biome check .",
		"test": "bun test",
		"clean": "rm -rf .turbo node_modules"
	},
	"dependencies": {
		"@better-auth/api-key": "1.7.2",
		"@better-auth/oauth-provider": "1.7.2",
		"@better-auth/sso": "1.7.2",
		"@crm/db": "workspace:*",
		"@crm/env": "workspace:*",
		"@crm/validation": "workspace:*",
		"better-auth": "1.7.2",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"react": "^19.2.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@better-auth/cli": "1.4.22",
		"@crm/typescript-config": "workspace:*",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.18",
		"react": "^19.2.8",
		"typescript": "5.9.2"
	}
}
