  idempotencyKey String           @unique
  correlationId  String           @unique

  input   Json?
  result  Json?
  summary String?

  modelId      String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(12, 6)
  budgetTokens Int?
  budgetUsd    Decimal? @db.Decimal(12, 6)
  modelUsage   Json?
  channel      String?
  provider     String?
  scopes       Json?

  approvalRequestId     String?
  approvalContentDigest String?
  approvalRequest       ApprovalRequest? @relation("ApprovalRequestAgentRuns", fields: [approvalRequestId, approvalContentDigest], references: [id, contentDigest], onDelete: Restrict, map: "agentRun_approval_scope_fkey")

  errorCode    String?
  errorMessage String?

