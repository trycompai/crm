  id            String                @id @default(cuid())
  workspaceId   String
  workspace     Organization          @relation("PipelineStageWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  order         Int
  name          String
  category      PipelineStageCategory
  entryCriteria String?
  exitCriteria  String?
  description   String?
  isActive      Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, order])
  @@unique([workspaceId, name])
  @@index([workspaceId, category])
}

model ContentDraft {
  id                  String      @id @default(cuid())
  type                ContentType
  title               String?
  body                String
  status              DraftStatus @default(DRAFT)
  authorId            String?
  author              User?       @relation("ContentDraftAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  approverId          String?
  approver            User?       @relation("ContentDraftApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvalCode        String?     @unique
  scheduledAt         DateTime?
  publishedAt         DateTime?
  publicationReceipts Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([authorId])
}

model SocialDraft {
  id             String         @id @default(cuid())
  platform       SocialPlatform
  content        String
  scheduledAt    DateTime?
  status         DraftStatus    @default(DRAFT)
  authorId       String?
  author         User?          @relation("SocialDraftAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  approverId     String?
  approver       User?          @relation("SocialDraftApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvalCode   String?        @unique
  publishedAt    DateTime?
  publishReceipt Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([authorId])
}

model DiscoveryLearning {
  id        String   @id @default(cuid())
  source    String
  evidence  Json?
  tags      Json?
  companyId String?
  company   Company? @relation("DiscoveryLearningCompany", fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation("DiscoveryLearningContact", fields: [contactId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation("DiscoveryLearningDeal", fields: [dealId], references: [id], onDelete: SetNull)
  sessionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([contactId, createdAt])
  @@index([dealId, createdAt])
  @@index([source, createdAt])
}

model HermesAudit {
  id        String   @id @default(cuid())
  tool      String
  args      Json?
  outcome   String
  sessionId String
  model     String?
  cost      Decimal? @db.Decimal(14, 4)
  userId    String?
  user      User?    @relation("HermesAuditUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tool, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId])
}
