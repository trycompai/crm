  actions AgentAction[]

  @@unique([id, agentId])
  @@index([agentId, createdAt])
  @@index([versionId, createdAt])
  @@index([status, createdAt])
  @@index([triggerId, createdAt])
  @@index([subjectType, subjectId])
  @@index([operationKey])
  @@index([approvalRequestId, approvalContentDigest], map: "agentRun_approval_scope_idx")
  @@index([channel, provider])
  @@map("agentRun")
}

model AgentRunEvent {
