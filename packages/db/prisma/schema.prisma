  provider          String
  operation         String
  operationKey      String?
  idempotencyKey    String                  @unique
  status            ProviderOperationStatus @default(QUEUED)
  request           Json?
  response          Json?
  externalId        String?
  attemptCount      Int                     @default(0)
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime                @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime                @updatedAt

  receipt ActionReceipt? @relation("ProviderOperationReceipt")

  @@unique([providerAccountId, externalId])
  @@unique([id, providerAccountId, provider], map: "providerOperation_receipt_scope_key")
  @@index([customerAccountId, status, createdAt])
  @@index([instanceId, status, createdAt])
  @@index([providerAccountId, status, createdAt])
  @@index([planStepId])
  @@index([controlCommandId])
  @@index([operationKey])
  @@map("providerOperation")
}

model Incident {
  id             String           @id @default(cuid())
  instanceId     String
  instance       CustomerInstance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  provider       String?
  fingerprint    String?
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  title          String
  summary        String?
  detectedAt     DateTime         @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([instanceId, fingerprint])
  @@index([instanceId, status, severity, detectedAt])
  @@index([provider, status, detectedAt])
  @@map("incident")
}

model UsageSample {
  id                String            @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount   @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  instanceId        String?
  instance          CustomerInstance? @relation(fields: [instanceId, customerAccountId], references: [id, accountId], onDelete: Restrict)
  providerAccountId String?
  providerAccount   ProviderAccount?  @relation(fields: [providerAccountId, customerAccountId, provider], references: [id, customerAccountId, provider], onDelete: Restrict)
  provider          String?
  metric            String
  quantity          Decimal           @db.Decimal(20, 6)
  unit              String
  observedAt        DateTime
  dimensions        Json?
  source            String?
  createdAt         DateTime          @default(now())

  @@unique([customerAccountId, metric, observedAt])
  @@index([instanceId, metric, observedAt])
  @@index([providerAccountId, metric, observedAt])
  @@map("usageSample")
}

model CostLineItem {
  id                String            @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount   @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  instanceId        String?
  instance          CustomerInstance? @relation(fields: [instanceId, customerAccountId], references: [id, accountId], onDelete: Restrict)
  providerAccountId String?
  providerAccount   ProviderAccount?  @relation(fields: [providerAccountId, customerAccountId, provider], references: [id, customerAccountId, provider], onDelete: Restrict)
  provider          String
  externalId        String?
  category          String
  description       String?
  quantity          Decimal           @db.Decimal(20, 6)
  unitCost          Decimal           @db.Decimal(20, 8)
  totalCost         Decimal           @db.Decimal(20, 8)
  currency          String
  periodStart       DateTime
  periodEnd         DateTime
  metadata          Json?
  createdAt         DateTime          @default(now())

  @@unique([providerAccountId, externalId])
  @@unique([provider, externalId], map: "costLineItem_unbound_provider_externalId_key", where: { providerAccountId: null })
  @@index([customerAccountId, periodStart, periodEnd])
  @@index([instanceId, periodStart, periodEnd])
  @@index([provider, category, periodStart])
  @@map("costLineItem")
}

model InboundSourceReceipt {
  id               String    @id @default(cuid())
  connector        String
  provider         String
  accountId        String
  sourceObjectType String
  sourceObjectId   String
  sourceDigest     String
  sourceCreatedAt  DateTime?
  sourceUpdatedAt  DateTime?
  capturedAt       DateTime  @default(now())
  sourceUrl        String?
  redactedMetadata Json
  createdAt        DateTime  @default(now())

  observations      ContactCandidateObservation[]
  fieldProvenance   EntityFieldProvenance[]       @relation("InboundReceiptFieldProvenance")
  linkProvenance    EntityLinkProvenance[]        @relation("InboundReceiptLinkProvenance")
  recordQuarantines RecordQuarantine[]            @relation("InboundReceiptQuarantine")
  formSubmissions   FormSubmission[]              @relation("TrackingSubmissionReceipt")

  @@unique([connector, provider, accountId, sourceObjectType, sourceObjectId, sourceDigest], map: "inboundSourceReceipt_source_identity_key")
  @@unique([id, sourceDigest], map: "inboundSourceReceipt_id_sourceDigest_key")
  @@index([connector, accountId, capturedAt])
  @@index([provider, accountId, capturedAt])
  @@index([sourceDigest])
  @@map("inboundSourceReceipt")
}

model ContactCandidate {
  id                    String                          @id @default(cuid())
  identityKey           String
  canonicalIdentityKey  String                          @unique(map: "contactCandidate_canonicalIdentityKey_key") @default("")
  rawEmail              String?
  canonicalEmail        String?
  rawName               String?
  canonicalName         String?
  rawBusinessName       String?
  canonicalBusinessName String?
  rawDomain             String?
  canonicalDomain       String?
  status                ContactCandidateStatus          @default(PENDING)
  permissionState       ContactCandidatePermissionState @default(REVIEW_REQUIRED)
  proposedCompanyId     String?
  proposedCompany       Company?                        @relation("CandidateProposedCompany", fields: [proposedCompanyId], references: [id], onDelete: SetNull)
  proposedContactId     String?
  proposedContact       Contact?                        @relation("CandidateProposedContact", fields: [proposedContactId], references: [id], onDelete: SetNull)
  decisionById          String?
  decisionBy            User?                           @relation("ContactCandidateReviewer", fields: [decisionById], references: [id], onDelete: Restrict)
  decisionReason        String?
  decidedAt             DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  observations ContactCandidateObservation[]
  formSubmissions FormSubmission[] @relation("TrackingSubmissionCandidate")

  @@index([status, permissionState, updatedAt])
  @@index([identityKey], map: "contactCandidate_identityKey_idx")
  @@index([canonicalEmail])
  @@index([canonicalDomain, status])
  @@index([proposedCompanyId, status])
  @@index([proposedContactId, status])
  @@index([decisionById, decidedAt])
  @@map("contactCandidate")
}

model ContactCandidateObservation {
  id                     String               @id @default(cuid())
  candidateId            String
  candidate              ContactCandidate     @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  receiptId              String
  sourceDigest           String
  receipt                InboundSourceReceipt @relation(fields: [receiptId, sourceDigest], references: [id, sourceDigest], onDelete: Restrict)
  observationKey         String
  observationIdentityKey String               @unique(map: "contactCandidateObservation_observationIdentityKey_key") @default("")
  observedEmail          String?
  observedName           String?
  observedTitle          String?
  observedCompany        String?
  observedDomain         String?
  observedRole           String?
  evidenceClass          String
  observedAt             DateTime             @default(now())
  createdAt              DateTime             @default(now())

  @@index([candidateId, observedAt])
  @@index([observationKey], map: "contactCandidateObservation_observationKey_idx")
  @@index([receiptId, sourceDigest])
  @@index([evidenceClass, observedAt])
  @@map("contactCandidateObservation")
}

model EntityFieldProvenance {
  id          String               @id @default(cuid())
  subjectType SubjectType
  subjectId   String
  fieldName   String
  valueDigest String
  receiptId   String
  receipt     InboundSourceReceipt @relation("InboundReceiptFieldProvenance", fields: [receiptId], references: [id], onDelete: Restrict)
  confidence  Float?
  method      String
  status      ProvenanceStatus     @default(PROPOSED)
  observedAt  DateTime             @default(now())
  freshUntil  DateTime?
  decidedById String?
  decidedBy   User?                @relation("EntityFieldProvenanceReviewer", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([subjectType, subjectId, fieldName, valueDigest, receiptId], map: "entityFieldProvenance_identity_key")
  @@unique([subjectType, subjectId, fieldName], map: "entityFieldProvenance_applied_subject_field_key", where: { status: "APPLIED" })
  @@index([subjectType, subjectId, fieldName, status], map: "entityFieldProvenance_subject_scope_idx")
  @@index([status, freshUntil])
  @@index([receiptId])
  @@index([decidedById, decidedAt])
  @@map("entityFieldProvenance")
}

model EntityLinkProvenance {
  id           String               @id @default(cuid())
  sourceType   SubjectType
  sourceId     String
  relationship String
  targetType   SubjectType
  targetId     String
  receiptId    String
  receipt      InboundSourceReceipt @relation("InboundReceiptLinkProvenance", fields: [receiptId], references: [id], onDelete: Restrict)
  confidence   Float?
  method       String
  status       ProvenanceStatus     @default(PROPOSED)
  observedAt   DateTime             @default(now())
  freshUntil   DateTime?
  decidedById  String?
  decidedBy    User?                @relation("EntityLinkProvenanceReviewer", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([sourceType, sourceId, relationship, targetType, targetId, receiptId], map: "entityLinkProvenance_identity_key")
  @@unique([sourceType, sourceId, relationship], map: "entityLinkProvenance_applied_source_relationship_key", where: { status: "APPLIED" })
  @@index([sourceType, sourceId, relationship, status], map: "entityLinkProvenance_source_scope_idx")
  @@index([targetType, targetId, relationship, status], map: "entityLinkProvenance_target_scope_idx")
  @@index([status, freshUntil])
  @@index([receiptId])
  @@index([decidedById, decidedAt])
  @@map("entityLinkProvenance")
}

model RecordQuarantine {
  id           String                 @id @default(cuid())
  subjectType  SubjectType
  subjectId    String
  sourceBatch  String?
  receiptId    String?
  receipt      InboundSourceReceipt?  @relation("InboundReceiptQuarantine", fields: [receiptId], references: [id], onDelete: Restrict)
  reason       String
  evidence     Json?
  status       RecordQuarantineStatus @default(ACTIVE)
  reviewedById String?
  reviewedBy   User?                  @relation("RecordQuarantineReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([subjectType, subjectId, reason], map: "recordQuarantine_active_subject_reason_key", where: { status: "ACTIVE" })
  @@index([subjectType, subjectId, status])
  @@index([sourceBatch, status])
  @@index([receiptId])
  @@index([reviewedById, reviewedAt])
  @@map("recordQuarantine")
}
