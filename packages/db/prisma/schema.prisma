model Company {
  id          String  @id @default(cuid())
  name        String
  domain      String? @unique
  website     String?
  description String?

  logoUrl     String?
  logoDarkUrl String?
  iconUrl     String?
  iconDarkUrl String?
  iconTone    String?
  brandColor  String?

  industry    String?
  subIndustry String?
  city        String?
  stateCode   String?
  country     String?
  countryCode String?

  phone       String?
  email       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  pricingUrl  String?
  careersUrl  String?

  ownerId          String?
  owner            User?    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryContactId String?  @unique
  primaryContact   Contact? @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  enrichmentStatus EnrichmentStatus   @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?
  enrichment       CompanyEnrichment?

  source RecordSource @default(MANUAL)

  lastActivityAt DateTime?

  contacts           Contact[]            @relation("CompanyContacts")
  conversations      AgentConversation[]
  deals              Deal[]
  activities         Activity[]
  emailThreads       EmailThread[]
  emailDrafts        EmailDraft[]
  websiteEnquiries   WebsiteEnquiry[]
  calendarEvents     CalendarEvent[]
  granolaNotes       GranolaNote[]
  fieldValues        FieldValue[]
  prospects          Prospect[]
  candidateProposals ContactCandidate[]   @relation("CandidateProposedCompany")
  onboardings        CustomerOnboarding[]
  customerAccount    CustomerAccount?
  approvalQueues     ApprovalQueue[]      @relation("ApprovalQueueCompany")
  discoveryLearnings DiscoveryLearning[]  @relation("DiscoveryLearningCompany")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([ownerId])
  @@index([name])
  @@index([lastActivityAt])
  @@map("company")
}

model CompanyEnrichment {
  companyId String   @id
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String   @default("context.dev")
  raw       Json
  fetchedAt DateTime @default(now())

  @@map("companyEnrichment")
}

model Contact {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String?
  email       String? @unique
  phone       String?
  title       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  imageUrl    String?

  socialsCheckedAt DateTime?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?

  brief         ContactBrief?
  facts         ContactFact[]
  conversations AgentConversation[]

  companyId String?
  company   Company? @relation("CompanyContacts", fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryOf Company? @relation("PrimaryContact")

  source RecordSource @default(MANUAL)

  lastActivityAt DateTime?

  deals              DealContact[]
  activities         Activity[]
  emailThreads       EmailThread[]
  emailDrafts        EmailDraft[]
  websiteEnquiries   WebsiteEnquiry[]
  calendarEvents     CalendarEvent[]
  eventAttendance    CalendarAttendee[]
  granolaNotes       GranolaNote[]
  fieldValues        FieldValue[]
  prospects          Prospect[]
  candidateProposals ContactCandidate[]  @relation("CandidateProposedContact")
  discoveryLearnings DiscoveryLearning[] @relation("DiscoveryLearningContact")
  visitors           TrackedVisitor[]   @relation("VisitorContact")
  submissions        FormSubmission[]   @relation("SubmissionContact")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([lastActivityAt])
  @@map("contact")
}

model Prospect {
  id                   String                  @id @default(cuid())
  dedupeKey            String                  @unique
  region               String
  country              String
  countryCode          String
  companyName          String
  website              String?
  location             String?
  fitScore             Int?
  painStrength         Int?
  productFit           Int?
  timing               Int?
  reachability         Int?
  evidenceQuality      Int?
  status               ProspectStatus          @default(CANDIDATE)
  routeStatus          ProspectRouteStatus     @default(NONE)
  enrichmentStatus     EnrichmentStatus        @default(PENDING)
  enrichedAt           DateTime?
  enrichmentError      String?
  namedPerson          String?
  role                 String?
  routeEmail           String?
  routeType            String?
  emailAllowed         Boolean                 @default(false)
  emailAllowedAt       DateTime?
  emailAllowedById     String?
  emailAllowedBy       User?                   @relation("ProspectOutreachPermission", fields: [emailAllowedById], references: [id], onDelete: SetNull)
  companyProof         String?
  personSourceUrl      String?
  personalHook         String?
  jobDayProblem        String?
  painSignal           String?
  whyFit               String?
  whyNow               String?
  suggestedChannel     String?
  caution              String?
  opener               String?
  draftSubject         String?
  draftBody            String?
  nextAction           String?
  blockReason          String?
  sourceBatch          String
  sourceUrl            String?
  lastResearchedAt     DateTime?
  nextResearchAt       DateTime?
  suppressionCheckedAt DateTime?
  promotedAt           DateTime?
  researchVersion      Int                     @default(1)
  companyId            String?
  company              Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId            String?
  contact              Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  evidence             ProspectEvidence[]
  sourceReceipts       ProspectSourceReceipt[]
  emailDrafts          EmailDraft[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([countryCode, status, fitScore])
  @@index([status, createdAt])
  @@index([routeStatus])
  @@index([nextResearchAt, status])
  @@index([companyId])
  @@index([contactId])
  @@index([emailAllowedById])
  @@map("prospect")
}

model ProspectEvidence {
  id         String                 @id @default(cuid())
  prospectId String
  prospect   Prospect               @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  receiptId  String?                @unique
  receipt    ProspectSourceReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  sourceType String
  title      String?
  url        String
  signalDate DateTime?
  summary    String
  observed   String?
  inference  String?
  createdAt  DateTime               @default(now())

  @@unique([prospectId, url])
  @@index([prospectId])
  @@map("prospectEvidence")
}

model ProspectSourceReceipt {
  id           String            @id @default(cuid())
  prospectId   String
  prospect     Prospect          @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  requestedUrl String
  finalUrl     String
  fetchedAt    DateTime          @default(now())
  statusCode   Int
  contentType  String?
  contentHash  String
  contentText  String
  evidence     ProspectEvidence?

  @@index([prospectId, fetchedAt])
  @@index([contentHash])
  @@map("prospectSourceReceipt")
}

enum FactBand {
  VERIFIED
  PROBABLE
  POSSIBLE
}

enum FactStatus {
  APPLIED
  PROPOSED
  DISMISSED
  SUPERSEDED
}

model ContactFact {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  field String
  value String

  score Float
  band  FactBand

  evidence Json

  method    String
  sourceUrl String?

  sessionId String?

  status      FactStatus @default(PROPOSED)
  decidedById String?
  decidedBy   User?      @relation("FactDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  observedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@index([contactId, field, status])
  @@index([status, observedAt])
  @@map("contactFact")
}

model ContactBrief {
  contactId String  @id
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  narrative String
  sections  Json

  score     Float
  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("contactBrief")
}

model AgentTask {
  id           String  @id @default(cuid())
  contactId    String?
  companyId    String?
  prospectId   String?
  dealId       String?
  emailDraftId String?

  subjectType  SubjectType?
  subjectId    String?
  subjectLabel String?

  kind    String
  reason  String
  payload Json?

  priority Int            @default(0)
  budget   Int            @default(4)
  attempts Int            @default(0)
  state    AgentTaskState @default(QUEUED)

  operationKey          String?
  idempotencyKey        String?          @unique
  budgetTokens          Int?
  budgetUsd             Decimal?         @db.Decimal(12, 6)
  costUsd               Decimal?         @db.Decimal(12, 6)
  modelId               String?
  inputTokens           Int?
  outputTokens          Int?
  modelUsage            Json?
  channel               String?
  provider              String?
  scopes                Json?
  approvalRequestId     String?
  approvalContentDigest String?
  approvalRequest       ApprovalRequest? @relation("ApprovalRequestAgentTasks", fields: [approvalRequestId, approvalContentDigest], references: [id, contentDigest], onDelete: Restrict, map: "agentTask_approval_scope_fkey")

  dueAt       DateTime
  leasedUntil DateTime?

  sessionId  String?
  startedAt  DateTime?
  finishedAt DateTime?
  outcome    String?

  subject String?

  createdAt DateTime @default(now())

  @@index([dueAt, leasedUntil])
  @@index([contactId])
  @@index([prospectId])
  @@index([dealId])
  @@index([emailDraftId])
  @@index([subjectType, subjectId])
  @@index([operationKey])
  @@index([approvalRequestId, approvalContentDigest], map: "agentTask_approval_scope_idx")
  @@index([channel, provider])
  @@index([kind, subject], where: { finishedAt: null })
  @@map("agentTask")
}

model AgentEvent {
  id             String             @id
  sessionId      String
  contactId      String?
  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           String
  data           Json

  emittedAt DateTime

  @@index([sessionId, emittedAt])
  @@index([contactId, emittedAt])
  @@index([conversationId, emittedAt])
  @@map("agentEvent")
}

model AgentConversation {
  id String @id @default(cuid())

  kind AgentConversationKind @default(RECORD)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)

  agentId String?
  agent   AgentDefinition? @relation(fields: [agentId], references: [id], onDelete: SetNull)

